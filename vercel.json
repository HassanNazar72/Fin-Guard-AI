{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{backend/**,public/sample_uk_statement.csv}",
      "excludeFiles": "{.next/**,node_modules/**,.venv/**,tests/**,evals/**,scripts/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
